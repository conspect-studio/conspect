#!/usr/sbin/nft -f
# Pre-socket per-source floor for UDP 443 (ADR-0107 design note, section 11,
# "Pre-socket per-source limits"; slice 3, issue #289).
#
# This is the SECOND of the three layers the design describes: it stops a
# single real (non-spoofed) source from pushing the kernel receive queue past
# what validated-flow steering (layer 1, in the engine) can protect. It does
# NOT stop a spoofed or distributed flood (nftables has no return-routability
# proof); that remains an upstream/DDoS-provider problem. Required before UDP
# 443 is opened to the internet (design note section 11).
#
# Install:   sudo nft -f deploy/nftables/conspect-udp443-floor.nft
# Verify:    sudo nft list table inet conspect_floor
# Uninstall: sudo nft delete table inet conspect_floor
# Validate without installing (no CAP_NET_ADMIN / inside a container):
#            unshare -Urn nft -c -f - < deploy/nftables/conspect-udp443-floor.nft
# Behaviour test (netns, not CI): deploy/nftables/test-floor.sh
#
# The engine (running unprivileged, without CAP_NET_ADMIN) cannot list this
# ruleset itself; the shipped systemd unit's `ExecStartPre=+` runs
# `nft -j list table inet conspect_floor` as root and writes the JSON to
# /run/conspect-floor/nft-floor.json (`network.udp.nft_floor_status_file`)
# for the engine to parse as a plain file (design note "Slice 3 as built,
# part B"; `deploy/systemd/conspect.service`). The parser reports `present`
# only when, inside `table inet conspect_floor`, the chains `udp443_new` and
# `udp443_all` exist and the four sets below exist by these exact names and
# key types:
#   udp443_new_v4 (ipv4_addr)  udp443_new_v6 (ipv6_addr)
#   udp443_all_v4 (ipv4_addr)  udp443_all_v6 (ipv6_addr)
# Rename one and the status becomes `unknown`.
#
# Two tiers, both per IPv4 address and per IPv6 /64. Each UDP 443 packet is
# charged to EXACTLY ONE tier: the base chain jumps to one sub-chain, and
# every sub-chain ends in a verdict (accept or drop), so no packet reaches
# a second bucket.
#   * udp443_new (ct state new/untracked, i.e. a flow's first datagram
#     before the server has answered): 2000/s burst 1000 per source;
#   * udp443_all (everything else, i.e. established flows): 25000/s burst
#     10000 per source, above the engine's own per-established-peer bucket
#     (20000/s), so a real viewer is never hit by it.
# There is deliberately NO `ct state established accept`: one reply from the
# server (a QUIC Retry/Initial, a STUN error) makes a source "established" to
# conntrack, and an unconditional accept would then let that one real source
# flood UDP 443 unmetered. It is metered by udp443_all instead.
#
# Fail CLOSED when a set is full: `update @set { key limit rate R } accept`
# matches only when the source's element exists or could be added AND its
# bucket has a token; a source over its rate, or one that cannot be added
# because the set already holds `size` elements, falls through to the
# sub-chain's final `counter drop`. (Measured on nft 1.1.3: with size 2, a
# third source delivers 0. A `meter`/`limit rate over ... drop` form fails
# OPEN instead: a full meter matches nothing and the packet reaches
# `policy accept`. Note also that a plain `ip saddr @set` lookup on these
# sets evaluates the element's limit and consumes a token, so it must not
# be used as a separate "is the source in the set" test.)
# Only UDP 443 is decided in the sub-chains; the base chain keeps
# `policy accept`, so other traffic on the host is never touched.
#
# `size` bounds each set (a distributed flood of distinct sources cannot
# grow it past 65536 entries; beyond that, NEW sources are dropped until
# entries expire); `timeout` expires an idle source's bucket (each `update`
# refreshes it). The `counter` on each sub-chain's drop shows which tier
# fires (`nft list table inet conspect_floor`).

table inet conspect_floor {
	set udp443_new_v4 { type ipv4_addr; size 65536; flags dynamic,timeout; timeout 2m; }
	# IPv6 sets are keyed on the source /64 (`ip6 saddr and
	# ffff:ffff:ffff:ffff::`), so a host cannot get a fresh budget per
	# address inside its own /64.
	set udp443_new_v6 { type ipv6_addr; size 65536; flags dynamic,timeout; timeout 2m; }
	set udp443_all_v4 { type ipv4_addr; size 65536; flags dynamic,timeout; timeout 2m; }
	set udp443_all_v6 { type ipv6_addr; size 65536; flags dynamic,timeout; timeout 2m; }

	chain input {
		# One step ahead of the default filter priority 0.
		type filter hook input priority -5; policy accept;

		udp dport 443 ct state new,untracked jump udp443_new
		udp dport 443 jump udp443_all
	}

	# New flows: 2000/s burst 1000 per source; ends in a verdict.
	chain udp443_new {
		update @udp443_new_v4 { ip saddr limit rate 2000/second burst 1000 packets } accept
		update @udp443_new_v6 { ip6 saddr and ffff:ffff:ffff:ffff:: limit rate 2000/second burst 1000 packets } accept
		counter drop
	}

	# Established flows: 25000/s burst 10000 per source; ends in a verdict.
	chain udp443_all {
		update @udp443_all_v4 { ip saddr limit rate 25000/second burst 10000 packets } accept
		update @udp443_all_v6 { ip6 saddr and ffff:ffff:ffff:ffff:: limit rate 25000/second burst 10000 packets } accept
		counter drop
	}
}
