#!/usr/sbin/nft -f
# Pre-socket per-source floor for UDP 443 (ADR-0107 design note, section 11,
# "Pre-socket per-source limits"; slice 3, issue #289).
#
# This is the SECOND of the three layers the design describes: it stops a
# single real (non-spoofed) source from pushing the kernel receive queue past
# what validated-flow steering (layer 1, in the engine) can protect. It does
# NOT stop a spoofed or distributed flood (nftables has no return-routability
# proof); that remains an upstream/DDoS-provider problem. Required before UDP
# 443 is opened to the internet (design note section 11).
#
# Install:   sudo nft -f deploy/nftables/conspect-udp443-floor.nft
# Verify:    sudo nft list table inet conspect_floor
# Uninstall: sudo nft delete table inet conspect_floor
# Validate without installing (no CAP_NET_ADMIN / inside a container):
#            unshare -Urn nft -c -f - < deploy/nftables/conspect-udp443-floor.nft
# Behaviour test (netns, not CI): deploy/nftables/test-floor.sh
#
# The engine (running unprivileged, without CAP_NET_ADMIN) cannot list this
# ruleset itself; the shipped systemd unit's `ExecStartPre=+` runs
# `nft -j list table inet conspect_floor` as root and writes the JSON to
# `network.udp.nft_floor_status_file` for the engine to read as a plain file
# parse (design note "Slice 3 as built, part B"; `deploy/systemd/conspect.service`).
# The parser reports `present` only when ALL FOUR meters below exist, by these
# exact names, inside `table inet conspect_floor`:
#   conspect_udp443_new_v4  conspect_udp443_new_v6
#   conspect_udp443_all_v4  conspect_udp443_all_v6
# Rename one and the status becomes `unknown`.
#
# Two tiers, both per IPv4 address and per IPv6 /64:
#   * new  (ct state new/untracked): 2000/s burst 1000 per source;
#   * all  (every UDP 443 packet, established or not): 25000/s burst 10000
#     per source, above the engine's own per-established-peer bucket
#     (20000/s), so a real viewer is never hit by it.
# There is deliberately NO `ct state established accept`: one reply from the
# server (a QUIC Retry/Initial, a STUN error) makes a source "established" to
# conntrack, and an unconditional accept would then let that one real source
# flood UDP 443 unmetered. Proven by deploy/nftables/test-floor.sh.
#
# `size` bounds each dynamic set (a distributed flood of distinct sources
# cannot grow it past 65536 entries); `timeout` expires an idle source's
# bucket. `counter` on each drop lets an operator see which tier fires
# (`nft list table inet conspect_floor`).

table inet conspect_floor {
	chain input {
		# One step ahead of the default filter priority 0.
		type filter hook input priority -5; policy accept;

		# Tier 1, new flows, IPv4: one bucket per source address.
		udp dport 443 meta nfproto ipv4 ct state new,untracked \
			meter conspect_udp443_new_v4 size 65536 { \
				ip saddr timeout 2m limit rate over 2000/second burst 1000 packets \
			} counter drop

		# Tier 1, new flows, IPv6: one bucket per /64 (`ip6 saddr and
		# ffff:ffff:ffff:ffff::` masks to the prefix, so a host cannot get a
		# fresh budget per address inside its own /64).
		udp dport 443 meta nfproto ipv6 ct state new,untracked \
			meter conspect_udp443_new_v6 size 65536 { \
				ip6 saddr and ffff:ffff:ffff:ffff:: timeout 2m limit rate over 2000/second burst 1000 packets \
			} counter drop

		# Tier 2, every UDP 443 packet, IPv4, per source address.
		udp dport 443 meta nfproto ipv4 \
			meter conspect_udp443_all_v4 size 65536 { \
				ip saddr timeout 2m limit rate over 25000/second burst 10000 packets \
			} counter drop

		# Tier 2, every UDP 443 packet, IPv6, per /64.
		udp dport 443 meta nfproto ipv6 \
			meter conspect_udp443_all_v6 size 65536 { \
				ip6 saddr and ffff:ffff:ffff:ffff:: timeout 2m limit rate over 25000/second burst 10000 packets \
			} counter drop
	}
}
