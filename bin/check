#!/usr/bin/env bash
# Repository local gate: the full CI set documented in AGENTS.md
# ("Commands" -> full CI set). The pre-push hook runs this through the DSH
# local-gate wrapper; CI still runs its own full matrix.
#
# It replaces a task-specific MoQ branch gate that merged to main and could
# only ever pass for that one branch's exact commit.
set -euo pipefail
cd "$(dirname "$0")/.."
test -z "$(git status --porcelain --untracked-files=all)" || {
  echo "bin/check: working tree must be clean" >&2; exit 1; }
set -x
cargo fmt --all -- --check
cargo clippy --locked --workspace --all-targets -- -D warnings
# tile_driven_meets_budget is a wall-clock budget test; ci.yml skips it on
# shared runners for the same reason.
cargo test --locked --workspace -- --skip tile_driven_meets_budget
cargo deny check
