root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{rs}]
indent_size = 4

[*.{js,jsx,ts,tsx,json,css,html,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Recorded caption fixtures keep their wire bytes (space-padded cue lines).
[*.vtt]
trim_trailing_whitespace = false
